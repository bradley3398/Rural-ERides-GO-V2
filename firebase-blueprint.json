    "RiderProfile": {
      "title": "RiderProfile",
      "description": "Owner-only PEV rider profile, emergency contacts, and preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "callsign": { "type": "string" },
        "email": { "type": "string" },
        "activeVehicleId": { "type": "string" },
        "unitSystem": { "type": "string", "enum": ["IMPERIAL", "METRIC"] },
        "emergencyContactName": { "type": "string" },
        "sosContactNumber": { "type": "string" },
        "medicalProfile": { "type": "string" },
        "acceptedLegal": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "callsign", "email", "activeVehicleId", "unitSystem", "emergencyContactName", "sosContactNumber", "medicalProfile", "acceptedLegal", "createdAt", "updatedAt"]
    },
