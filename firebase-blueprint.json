  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/RiderProfile" },
      "description": "Owner-only PEV rider profile and PII settings."
    },
    "/users/{userId}/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/PevVehicle" },
      "description": "PEVs registered in the owner's garage."
    },
    "/users/{userId}/rides/{rideId}": {
      "schema": { "$ref": "#/entities/RideSession" },
      "description": "GPS telemetry ride logs owned by the user."
    },
    "/users/{userId}/maintenance/{taskId}": {
      "schema": { "$ref": "#/entities/MaintenanceTask" },
      "description": "Maintenance tasks owned by the user."
    },
    "/users/{userId}/saved_videos/{videoId}": {
      "schema": { "$ref": "#/entities/SavedVideo" },
      "description": "Watchlist and notes for saved YouTube videos."
    },
    "/users/{userId}/prayers/{prayerId}": {
      "schema": { "$ref": "#/entities/PrayerJournalEntry" },
      "description": "Personal Rider's Prayer journal entries."
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Targeted user inbox notifications."
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": { "$ref": "#/entities/CloudBackup" },
      "description": "Owner-only full settings and garage cloud backup snapshots."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role grant records."
    },
    "/user_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicPilotProfile" },
      "description": "Public pilot callsigns, rank badges, XP, and telemetry totals."
    },
    "/board_posts/{postId}": {
      "schema": { "$ref": "#/entities/BoardPost" },
      "description": "Community feed transmissions across all categories."
    },
    "/board_posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/BoardComment" },
      "description": "Comments under a community board post."
    },
    "/board_posts/{postId}/likes/{likeUserId}": {
      "schema": { "$ref": "#/entities/BoardLike" },
      "description": "Volt reaction markers on a community board post."
    },
    "/radar_riders/{riderId}": {
      "schema": { "$ref": "#/entities/RadarRider" },
      "description": "Live Rider Radar position beacons."
    },
    "/radar_meetups/{meetupId}": {
      "schema": { "$ref": "#/entities/RadarMeetup" },
      "description": "Group Ride Meetup pins on Rider Radar."
    },
    "/radar_hazards/{hazardId}": {
      "schema": { "$ref": "#/entities/RadarHazard" },
      "description": "Trail hazard and speed trap pins on Rider Radar."
    },
    "/radar_waypoints/{waypointId}": {
      "schema": { "$ref": "#/entities/RadarWaypoint" },
      "description": "Shared charging, repair, and scenic waypoints."
    },
    "/channels/{channelId}/presence/{peerId}": {
      "schema": { "$ref": "#/entities/ChannelPresence" },
      "description": "Active P2P Walkie-Talkie operators per channel."
    },
    "/channels/{channelId}/state/{stateId}": {
      "schema": { "$ref": "#/entities/ChannelSpeakerState" },
      "description": "Half-duplex speaker floor state per channel."
    },
    "/channels/{channelId}/walkie/{msgId}": {
      "schema": { "$ref": "#/entities/WalkieVoiceLog" },
      "description": "Async Push-to-Talk voice transmission logs."
    },
    "/direct_messages/{threadId}": {
      "schema": { "$ref": "#/entities/DmThread" },
