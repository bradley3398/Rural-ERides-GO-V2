# Dedicated Per-Service API Keys (Managed via AI Studio Secrets panel)
# Note: Gemini AI uses keyless Firebase AI Logic + App Check (no GEMINI_API_KEY required).

# YOUTUBE_API_KEY: Live YouTube Data API v3 channel feed, search, playlists, and video stats.
YOUTUBE_API_KEY=MY_YOUTUBE_API_KEY

# SUPABASE: Supabase GoTrue rider authentication & cloud session sync.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY

# MAPBOX_ACCESS_TOKEN: Mapbox high-res tiles, geocoding, and Turn-by-Turn GPS Directions.
MAPBOX_ACCESS_TOKEN=MY_MAPBOX_ACCESS_TOKEN

# OPENROUTESERVICE_API_KEY: Dedicated PEV / electric-cycling Turn-by-Turn GPS Navigation & elevation routing.
OPENROUTESERVICE_API_KEY=MY_OPENROUTESERVICE_API_KEY

# TOMTOM_API_KEY: TomTom live traffic, speed limits, geocoding, and Turn-by-Turn routing.
TOMTOM_API_KEY=MY_TOMTOM_API_KEY

# OPENCHARGEMAP_API_KEY: Dedicated live public EV / PEV charging station locator API.
OPENCHARGEMAP_API_KEY=MY_OPENCHARGEMAP_API_KEY

# ELEVATION_API_KEY: Dedicated terrain elevation profile API (falls back to keyless Open-Elevation).
ELEVATION_API_KEY=MY_ELEVATION_API_KEY

# WEATHER_API_KEY: OpenWeatherMap live hyperlocal weather (paired with Open-Meteo).
WEATHER_API_KEY=MY_WEATHER_API_KEY

# TAVILY_API_KEY & BRAVE_API_KEY: Live web grounding & real-time PEV search for Co-Pilot and Spec Engine.
TAVILY_API_KEY=MY_TAVILY_API_KEY
BRAVE_API_KEY=MY_BRAVE_API_KEY

# NEWS_API_KEY: Live PEV & micro-mobility news feeds.
NEWS_API_KEY=MY_NEWS_API_KEY

# IMGBB_API_KEY: External image hosting for shared media.
IMGBB_API_KEY=MY_IMGBB_API_KEY

# GOOGLE_CSE_KEY & GOOGLE_CSE_CX: Dedicated Google Custom Search for PEV product images & parts lookup.
GOOGLE_CSE_KEY=MY_GOOGLE_CSE_KEY
GOOGLE_CSE_CX=MY_GOOGLE_CSE_CX
