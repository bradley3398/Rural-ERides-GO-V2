# Rural ERides GO — Secrets & Cloud API Configuration
#
# Configure these values in the Secrets panel in AI Studio (never commit a .env file):
# - SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
# - SUPABASE_ANON_KEY: Your Supabase project anon/publishable key
#
# Google Cloud Console / Maps / YouTube / Custom Search Secrets:
# - GOOGLE_MAPS_API_KEY / MAPS_API_KEY / GOOGLE_CLOUD_API_KEY / GOOGLE_API_KEY
# - YOUTUBE_API_KEY / YOUTUBE_API_KEY_2 / YOUTUBE_API_KEY_3
# - GOOGLE_CSE_API_KEY / GOOGLE_CSE_CX / GOOGLE_CSE_API_KEY_2 / GOOGLE_CSE_CX_2
# - ELEVATION_API_KEY
#
# Navigation, Speed Limit, Weather, Search & Media Secrets:
# - TOMTOM_API_KEY / TOMTOM_API_KEY_2
# - MAPBOX_ACCESS_TOKEN / MAPBOX_ACCESS_TOKEN_2
# - OPENROUTESERVICE_API_KEY / OPENROUTESERVICE_API_KEY_2
# - OPENCHARGEMAP_API_KEY / OPENCHARGEMAP_API_KEY_2
# - OPENWEATHER_API_KEY / OPENWEATHER_API_KEY_2 / WEATHER_API_KEY
# - TAVILY_API_KEY / TAVILY_API_KEY_2
# - BRAVE_API_KEY / BRAVE_SEARCH_API_KEY / BRAVE_API_KEY_2
# - NEWS_API_KEY / NEWS_API_KEY_2
# - IMGBB_API_KEY / IMGBB_API_KEY_2
#
# Gemini AI (Google Cloud Console Generative Language API Keys):
# - GEMINI_API_KEY / GEMINI_API_KEY_2 (or fallback GOOGLE_CLOUD_API_KEY / GOOGLE_API_KEY)

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY_2=YOUR_GEMINI_API_KEY_2

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
MAPS_API_KEY=YOUR_MAPS_API_KEY
GOOGLE_CLOUD_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
YOUTUBE_API_KEY_2=YOUR_YOUTUBE_API_KEY_2
YOUTUBE_API_KEY_3=YOUR_YOUTUBE_API_KEY_3

GOOGLE_CSE_API_KEY=YOUR_GOOGLE_CSE_API_KEY
GOOGLE_CSE_CX=YOUR_GOOGLE_CSE_CX
GOOGLE_CSE_API_KEY_2=YOUR_GOOGLE_CSE_API_KEY_2
GOOGLE_CSE_CX_2=YOUR_GOOGLE_CSE_CX_2

TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY
TOMTOM_API_KEY_2=YOUR_TOMTOM_API_KEY_2

MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN
MAPBOX_ACCESS_TOKEN_2=YOUR_MAPBOX_ACCESS_TOKEN_2

OPENROUTESERVICE_API_KEY=YOUR_OPENROUTESERVICE_API_KEY
OPENROUTESERVICE_API_KEY_2=YOUR_OPENROUTESERVICE_API_KEY_2

OPENCHARGEMAP_API_KEY=YOUR_OPENCHARGEMAP_API_KEY
OPENCHARGEMAP_API_KEY_2=YOUR_OPENCHARGEMAP_API_KEY_2

ELEVATION_API_KEY=YOUR_ELEVATION_API_KEY

OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
OPENWEATHER_API_KEY_2=YOUR_OPENWEATHER_API_KEY_2
WEATHER_API_KEY=YOUR_WEATHER_API_KEY

TAVILY_API_KEY=YOUR_TAVILY_API_KEY
TAVILY_API_KEY_2=YOUR_TAVILY_API_KEY_2

BRAVE_API_KEY=YOUR_BRAVE_API_KEY
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_API_KEY
BRAVE_API_KEY_2=YOUR_BRAVE_API_KEY_2

NEWS_API_KEY=YOUR_NEWS_API_KEY
NEWS_API_KEY_2=YOUR_NEWS_API_KEY_2

IMGBB_API_KEY=YOUR_IMGBB_API_KEY
IMGBB_API_KEY_2=YOUR_IMGBB_API_KEY_2
