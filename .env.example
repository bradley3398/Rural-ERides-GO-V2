# Rural ERides GO — Public & Supabase Configuration
#
# Configure these values in the Secrets panel in AI Studio (never commit a .env file):
# - SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
# - SUPABASE_ANON_KEY: Your Supabase project anon/publishable key
#
# For Non-Play Google Sign-In via Supabase:
#   Enable the Google provider in Supabase Auth -> Providers and add
#   "ruralerides://auth/callback" to Supabase Auth -> URL Configuration -> Redirect URLs.
#
# Note: Gemini AI uses Firebase AI Logic + App Check (no GEMINI_API_KEY needed).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
